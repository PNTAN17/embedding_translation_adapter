{
  "selection_metric": "micro_macro_f1_sum",
  "epochs": 10,
  "patience": 5,
  "batch_size": 32,
  "learning_rate": 0.00001,
  "weight_decay": 0.01,
  "alignment_source": "both",
  "claim_weight": 1.0,
  "evidence_weight": 1.0,
  "task_loss_weight": 0.0,
  "task_class_weighting": "none",
  "drop_last": false,
  "scheduler_metric": "selection",
  "route_evidence_through_adapter": true,
  "use_images": true,
  "hidden_dim": 1280,
  "encoder_layers": 4,
  "decoder_layers": 2,
  "heads": 16,
  "dropout": 0.1,
  "max_length": 77,
  "max_evidence": 5,
  "token_mse_weight": 1.0,
  "sentence_weight": 0.5,
  "contrastive_weight": 0.02,
  "cosine_weight": 0.02,
  "greedy_token_weight": 0.5,
  "token_variance_weight": 0.5,
  "sentence_variance_weight": 0.5,
  "contrastive_temperature": 0.07,
  "seed": 42,
  "amp": true
}
